# GEMINI_API_KEY: Required for server-side Gemini AI forensic analysis and chat.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional External Threat Intelligence API Keys (Server-Side Only)
# When omitted, URL & contact intelligence checks run in local forensic verification + AI assessment mode.
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
